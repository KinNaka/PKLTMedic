@{
    ViewData["Title"] = "Đăng Nhập";
}

<!-- ============================================================================
     TRANG ĐĂNG NHẬP - LOGIN PAGE
     ============================================================================
     Tính năng:
     - Design hiện đại, đẹp, center màn hình
     - Responsive với mobile và desktop
     - Có hiệu ứng fade-in khi load trang
     - Hiệu ứng hover trên form
     - Hiệu ứng focus trên input
     - Thông báo lỗi hiển thị rõ ràng
     - Side image (có thể tùy chỉnh background)

     Để tùy chỉnh:
     - Đổi màu theme: tìm --primary-color, --secondary-color
     - Đổi background image: sửa background-image url
     - Đổi font: tìm font-family: 'Segoe UI'
     ============================================================================ -->

<div class="login-container">
    <!-- Phần bên trái - Background với gradient -->
    <div class="login-background">
        <div class="login-overlay">
            <div class="login-brand">
                <h1>PKLT Medical</h1>
                <p>Hệ thống quản lý phòng khám hiện đại</p>
            </div>
        </div>
    </div>

    <!-- Phần bên phải - Form đăng nhập -->
    <div class="login-form-container">
        <div class="login-form-wrapper">
            <!-- Tiêu đề -->
            <div class="login-header">
                <h2>Xin chào 👋</h2>
                <p>Đăng nhập vào tài khoản của bạn</p>
            </div>

            <!-- Thông báo lỗi -->
            @if (ViewBag.Error != null)
            {
                <div class="alert-error">
                    <svg class="alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                    <span>@ViewBag.Error</span>
                </div>
            }

            <!-- Form đăng nhập -->
            <form asp-action="Login" class="login-form">
                <!-- Input Tên đăng nhập -->
                <div class="form-group">
                    <label for="username" class="form-label">
                        <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                        Tên đăng nhập
                    </label>
                    <input id="username"
                           type="text"
                           name="username"
                           class="form-input"
                           placeholder="Nhập tên đăng nhập của bạn"
                           required
                           autofocus />
                </div>

                <!-- Input Mật khẩu -->
                <div class="form-group">
                    <label for="password" class="form-label">
                        <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                        Mật khẩu
                    </label>
                    <input id="password"
                           type="password"
                           name="password"
                           class="form-input"
                           placeholder="Nhập mật khẩu của bạn"
                           required />
                </div>

                <!-- Nút đăng nhập -->
                <button type="submit" class="btn-login">
                    <span>Đăng nhập</span>
                    <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </button>
            </form>

            <!-- Footer -->
            <div class="login-footer">
                <p>© 2026 PKLT Medical System. Bảo vệ bởi mã hóa SSL 🔒</p>
            </div>
        </div>
    </div>
</div>