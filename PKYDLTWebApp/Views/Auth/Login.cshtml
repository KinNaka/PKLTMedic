@{
    ViewData["Title"] = "Login";
}


<h2>Đăng nhập</h2>


@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}



<form asp-action="Login">


    <div class="mb-3">

        <label>
            Tên đăng nhập
        </label>

        <input name="username"
               class="form-control" />

    </div>



    <div class="mb-3">

        <label>
            Mật khẩu
        </label>

        <input name="password"
               type="password"
               class="form-control" />

    </div>



    <button class="btn btn-primary">
        Đăng nhập
    </button>


</form>