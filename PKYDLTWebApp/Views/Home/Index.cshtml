@{
    ViewData["Title"] = "Dashboard";
}

<!-- ============================================================================
     TRANG DASHBOARD / HOME PAGE
     ============================================================================
     Tính năng:
     - Giao diện Dashboard hiện đại
     - Responsive với tất cả kích thước màn hình
     - Các card với hover effect
     - Status badges cho từng module
     - Quick stats phía trên
     - Organized layout cho dễ mở rộng sau này

     Để tùy chỉnh:
     - Thêm hoặc xóa card: chỉ cần thêm/xóa div.card-item
     - Đổi icon: sửa emoji hoặc SVG
     - Đổi màu: tìm background: linear-gradient
     - Thêm animated counter: thêm class animate-number
     ============================================================================ -->

<div class="dashboard-container">

    <!-- ========== HEADER / WELCOME SECTION ========== -->
    <div class="dashboard-header">
        <h1 class="dashboard-title">
            📊 Dashboard
        </h1>
        <p class="dashboard-subtitle">
            Quản lý phòng khám một cách hiệu quả
        </p>
        <div class="dashboard-welcome">
            <span>Xin chào,</span>
            <span class="welcome-name">@User.Identity.Name</span>
            <span>👋</span>
        </div>
    </div>

    <!-- ========== QUICK STATS SECTION (Có thể thêm số liệu thực) ========== -->
    <div class="quick-stats">
        <!-- Card Khách hàng -->
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);">
                👥
            </div>
            <div class="stat-content">
                <div class="stat-label">Khách hàng</div>
                <div class="stat-value">0</div>
            </div>
        </div>

        <!-- Card Doanh thu -->
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, #10B981 0%, #059669 100%);">
                💰
            </div>
            <div class="stat-content">
                <div class="stat-label">Doanh thu</div>
                <div class="stat-value">0 đ</div>
            </div>
        </div>

        <!-- Card Đơn hàng -->
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);">
                📦
            </div>
            <div class="stat-content">
                <div class="stat-label">Đơn hàng</div>
                <div class="stat-value">0</div>
            </div>
        </div>

        <!-- Card Kho -->
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, #8B5CF6 0%, #7C3AED 100%);">
                🏪
            </div>
            <div class="stat-content">
                <div class="stat-label">Tồn kho</div>
                <div class="stat-value">0</div>
            </div>
        </div>
    </div>

    <!-- ========== MAIN CARDS GRID - MENU CHÍNH ========== -->
    <div class="cards-grid">

        <!-- ========== KHÁCH HÀNG ========== -->
        <a asp-controller="Customers"
           asp-action="Index"
           class="card-item">
            <div class="card-header">
                <div class="card-icon">👥</div>
                <h3 class="card-title">Khách hàng</h3>
            </div>
            <div class="card-body">
                <p class="card-description">
                    Quản lý hồ sơ bệnh nhân, thông tin liên hệ và lịch sử điều trị
                </p>
                <span class="card-action">
                    Truy cập
                    <span>→</span>
                </span>
            </div>
        </a>

        <!-- ========== HÓA ĐƠN ========== -->
        <a asp-page="/Invoices/Index"
           class="card-item">
            <div class="card-header" style="background: linear-gradient(135deg, #10B981 0%, #059669 100%);">
                <div class="card-icon">🧾</div>
                <h3 class="card-title">Hóa đơn</h3>
            </div>
            <div class="card-body">
                <p class="card-description">
                    Xem và quản lý các hóa đơn bán hàng, in hóa đơn
                </p>
                <span class="card-action">
                    Truy cập
                    <span>→</span>
                </span>
            </div>
        </a>

        <!-- ========== NHẬP HÀNG ========== -->
        <a asp-page="/Imports/Index"
           class="card-item">
            <div class="card-header" style="background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);">
                <div class="card-icon">📥</div>
                <h3 class="card-title">Nhập hàng</h3>
            </div>
            <div class="card-body">
                <p class="card-description">
                    Quản lý nhập kho thuốc, sản phẩm từ các nhà cung cấp
                </p>
                <span class="card-action">
                    Truy cập
                    <span>→</span>
                </span>
            </div>
        </a>

        <!-- ========== BÁN HÀNG ========== -->
        <a asp-page="/Sales/Index"
           class="card-item">
            <div class="card-header" style="background: linear-gradient(135deg, #8B5CF6 0%, #7C3AED 100%);">
                <div class="card-icon">🛒</div>
                <h3 class="card-title">Bán hàng</h3>
            </div>
            <div class="card-body">
                <p class="card-description">
                    Tạo và quản lý đơn bán hàng cho khách hàng
                </p>
                <span class="card-action">
                    Truy cập
                    <span>→</span>
                </span>
            </div>
        </a>

        <!-- ========== KHO HÀNG ========== -->
        <a asp-page="/Inventory/Index"
           class="card-item">
            <div class="card-header" style="background: linear-gradient(135deg, #DC2626 0%, #991B1B 100%);">
                <div class="card-icon">📦</div>
                <h3 class="card-title">Kho</h3>
            </div>
            <div class="card-body">
                <p class="card-description">
                    Quản lý tồn kho, kiểm tra hàng tồn, số lượng còn lại
                </p>
                <span class="card-action">
                    Truy cập
                    <span>→</span>
                </span>
            </div>
        </a>

        <!-- ========== HỆ THỐNG (Admin Only - có thể bỏ ghi chú) ========== -->
        <a asp-controller="Users"
           asp-action="Index"
           class="card-item">
            <div class="card-header" style="background: linear-gradient(135deg, #6366F1 0%, #4F46E5 100%);">
                <div class="card-icon">⚙️</div>
                <h3 class="card-title">Quản lý người dùng</h3>
            </div>
            <div class="card-body">
                <p class="card-description">
                    Quản lý tài khoản, phân quyền cho người dùng hệ thống
                </p>
                <span class="card-action">
                    Truy cập
                    <span>→</span>
                </span>
            </div>
        </a>

    </div>

    <!-- ========== FOOTER SECTION ========== -->
    <div class="dashboard-footer">
        <p>
            <strong>💡 Mẹo:</strong> Nhấp vào bất kỳ card nào để truy cập các chức năng quản lý
        </p>
    </div>

</div>

<!-- ============================================================================
     CSS LƯU Ý:
     - Tất cả CSS responsive và animations nằm trong wwwroot/css/site.css
     - Theme colors được định nghĩa tại :root với --primary-color, ...
     - Để tùy chỉnh, chỉnh sửa các CSS variables thay vì hardcode colors
     - Hover effects sử dụng CSS transforms (không nặng hiệu suất)
     - Mobile-first design: default là mobile, sau đó media queries cho desktop
     ============================================================================ -->
