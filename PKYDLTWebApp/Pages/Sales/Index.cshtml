@page
@model PKYDLTWebApp.Pages.Sales.IndexModel
@{
    ViewData["Title"] = "Bán hàng";
}

<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-md-8">
            <h2 class="mb-2">🛒 Bán hàng</h2>
            <p class="text-muted">Quản lý đơn bán hàng cho khách hàng</p>
        </div>
        <div class="col-md-4 text-md-end">
            <a href="/Sales/Quick" class="btn btn-primary">
                ➕ Tạo đơn bán nhanh
            </a>
        </div>
    </div>

    <!-- Sales Table -->
    <div class="card">
        <div class="card-header bg-light">
            <h5 class="card-title mb-0">📋 Danh sách đơn bán (100 đơn gần nhất)</h5>
        </div>
        <div class="card-body p-0">
            @if (Model.Sales.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 15%">Mã đơn</th>
                                <th style="width: 15%">Ngày bán</th>
                                <th style="width: 20%">Khách hàng</th>
                                <th style="width: 15%">Tổng tiền</th>
                                <th style="width: 12%">Đã trả</th>
                                <th style="width: 12%">Còn lại</th>
                                <th style="width: 11%" class="text-center">Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sale in Model.Sales)
                            {
                                var remaining = sale.GetRemainingAmount();
                                var isOverdue = remaining > 0;

                                <tr>
                                    <td><strong>@sale.SaleCode</strong></td>
                                    <td>@sale.SaleDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @(sale.Customer?.FullName ?? "Khách lẻ")
                                    </td>
                                    <td><strong>@sale.TotalAmount.ToString("#,##0") đ</strong></td>
                                    <td>@sale.PaidAmount.ToString("#,##0") đ</td>
                                    <td>
                                        @if (remaining > 0)
                                        {
                                            <span class="text-danger">@remaining.ToString("#,##0") đ</span>
                                        }
                                        else
                                        {
                                            <span class="text-success">0 đ</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (sale.Status == "Hủy")
                                        {
                                            <span class="badge bg-danger">❌ Hủy</span>
                                        }
                                        else if (sale.PaymentStatus == "Đã thanh toán" || remaining <= 0)
                                        {
                                            <span class="badge bg-success">✅ Đã TT</span>
                                        }
                                        else if (isOverdue)
                                        {
                                            <span class="badge bg-warning">⚠️ Còn nợ</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@sale.PaymentStatus</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center p-5">
                    <p class="fs-5">📭 Chưa có đơn bán nào</p>
                    <a href="/Sales/Quick" class="btn btn-primary">➕ Tạo đơn bán đầu tiên</a>
                </div>
            }
        </div>
    </div>
</div>