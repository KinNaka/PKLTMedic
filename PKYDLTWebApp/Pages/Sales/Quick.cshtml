@page
@model PKYDLTWebApp.Pages.Sales.QuickModel
@{
    ViewData["Title"] = "Bán Hàng Nhanh";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">🛒 Bán Hàng Nhanh</h4>
                </div>
                <div class="card-body">
                    <form method="post" id="saleForm">
                        <!-- Mã ghi nhận & Khách hàng -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Mã ghi nhận:</label>
                                <input asp-for="Sale.SaleCode" class="form-control" readonly />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Khách hàng:</label>
                                <select asp-for="Sale.CustomerId" class="form-select">
                                    <option value="">-- Khách lẻ --</option>
                                    @foreach (var customer in Model.Customers)
                                    {
                                        <option value="@customer.Id">@customer.FullName (@customer.Phone)</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Thêm sản phẩm -->
                        <div class="card mb-3">
                            <div class="card-header bg-light">
                                <h6 class="mb-0">Thêm sản phẩm</h6>
                            </div>
                            <div class="card-body">
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <label class="form-label">Sản phẩm:</label>
                                        <select id="productSelect" class="form-select">
                                            <option value="">-- Chọn sản phẩm --</option>
                                            @foreach (var product in Model.Products)
                                            {
                                                <option value="@product.Id" data-price="@product.RetailPrice" data-unit="@product.Unit">
                                                    @product.ProductCode - @product.ProductName (@product.Unit)
                                                </option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Số lượng:</label>
                                        <input type="number" id="quantityInput" class="form-control" value="1" min="1" />
                                    </div>
                                    <div class="col-md-3 d-flex align-items-end">
                                        <button type="button" class="btn btn-primary w-100" onclick="addProduct()">
                                            ➕ Thêm
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Bảng sản phẩm -->
                        <table class="table table-hover" id="productsTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th>Đơn giá</th>
                                    <th>Số lượng</th>
                                    <th>Thành tiền</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="tableBody"></tbody>
                        </table>

                        <!-- Tính toán -->
                        <div class="row mt-4">
                            <div class="col-md-6 offset-md-6">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="row mb-2">
                                            <div class="col-6">Tổng tiền:</div>
                                            <div class="col-6 text-end"><strong id="subTotal">0đ</strong></div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-6">Chiết khấu (%):</div>
                                            <div class="col-6">
                                                <input type="number" id="discountPercent" class="form-control form-control-sm" 
                                                       value="0" step="0.1" onchange="calculateTotal()" />
                                            </div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-6">Chiết khấu (₫):</div>
                                            <div class="col-6 text-end"><strong id="discountAmount">0đ</strong></div>
                                        </div>
                                        <hr />
                                        <div class="row">
                                            <div class="col-6"><h5>Tổng phải trả:</h5></div>
                                            <div class="col-6 text-end"><h5 id="totalAmount" class="text-primary">0đ</h5></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Thanh toán -->
                        <div class="row mt-3">
                            <div class="col-md-12">
                                <div class="card">
                                    <div class="card-header bg-light">
                                        <h6 class="mb-0">Thanh toán</h6>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label asp-for="Sale.PaymentMethod" class="form-label">Phương thức</label>
                                                <select asp-for="Sale.PaymentMethod" class="form-select">
                                                    <option value="Tiền mặt">💵 Tiền mặt</option>
                                                    <option value="Chuyển khoản">🏦 Chuyển khoản</option>
                                                    <option value="QR Code">📱 QR Code</option>
                                                    <option value="Nợ">📝 Nợ</option>
                                                </select>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label">Khách trả:</label>
                                                <input type="number" id="paidAmount" class="form-control" value="0" 
                                                       onchange="calculateChange()" />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label">Thối lại:</label>
                                                <input type="number" id="change" class="form-control" readonly />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Hidden input để gửi details -->
                        <input type="hidden" id="detailsJson" name="detailsJson" />

                        <!-- Nút hành động -->
                        <div class="mt-4 d-grid gap-2 d-md-flex justify-content-md-end">
                            <a href="/Sales/Index" class="btn btn-secondary">Quay lại</a>
                            <button type="submit" class="btn btn-success btn-lg" onclick="prepareSubmit()">
                                💾 Ghi nhận bán hàng
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Sidebar: Recent sales -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-light">
                    <h6 class="mb-0">📋 Ghi chú</h6>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <strong>Hướng dẫn:</strong>
                        <ul class="mb-0">
                            <li>Chọn sản phẩm từ dropdown</li>
                            <li>Nhập số lượng muốn bán</li>
                            <li>Nhấn nút "Thêm"</li>
                            <li>Nhập số tiền khách trả</li>
                            <li>Nhấn "Ghi nhận bán hàng"</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- JavaScript -->
<script>
    let cartItems = [];

    function addProduct() {
        const select = document.getElementById('productSelect');
        const quantity = parseInt(document.getElementById('quantityInput').value) || 1;

        if (!select.value) {
            alert('Vui lòng chọn sản phẩm');
            return;
        }

        const option = select.options[select.selectedIndex];
        const productId = parseInt(select.value);
        const productName = option.text.split(' - ')[1];
        const unitPrice = parseFloat(option.dataset.price);
        const unit = option.dataset.unit;

        // Kiểm tra xem product đã có trong giỏ không
        let item = cartItems.find(x => x.productId === productId);
        if (item) {
            item.quantity += quantity;
        } else {
            cartItems.push({ productId, productName, unitPrice, unit, quantity });
        }

        renderTable();
        calculateTotal();

        // Reset input
        select.value = '';
        document.getElementById('quantityInput').value = '1';
    }

    function removeProduct(productId) {
        cartItems = cartItems.filter(x => x.productId !== productId);
        renderTable();
        calculateTotal();
    }

    function renderTable() {
        const tbody = document.getElementById('tableBody');
        tbody.innerHTML = '';

        cartItems.forEach(item => {
            const total = item.unitPrice * item.quantity;
            tbody.innerHTML += `
                <tr>
                    <td>${item.productName}<br/><small class="text-muted">${item.unit}</small></td>
                    <td>${item.unitPrice.toLocaleString('vi-VN')}đ</td>
                    <td><input type="number" value="${item.quantity}" min="1" onchange="updateQuantity(${item.productId}, this.value)" style="width: 60px;" class="form-control form-control-sm" /></td>
                    <td>${total.toLocaleString('vi-VN')}đ</td>
                    <td><button type="button" class="btn btn-sm btn-danger" onclick="removeProduct(${item.productId})">🗑</button></td>
                </tr>
            `;
        });
    }

    function updateQuantity(productId, newQuantity) {
        const item = cartItems.find(x => x.productId === productId);
        if (item) {
            item.quantity = parseInt(newQuantity) || 1;
            calculateTotal();
        }
    }

    function calculateTotal() {
        const subTotal = cartItems.reduce((sum, item) => sum + (item.unitPrice * item.quantity), 0);
        const discountPercent = parseFloat(document.getElementById('discountPercent').value) || 0;
        const discountAmount = subTotal * (discountPercent / 100);
        const totalAmount = subTotal - discountAmount;

        document.getElementById('subTotal').textContent = subTotal.toLocaleString('vi-VN') + 'đ';
        document.getElementById('discountAmount').textContent = discountAmount.toLocaleString('vi-VN') + 'đ';
        document.getElementById('totalAmount').textContent = totalAmount.toLocaleString('vi-VN') + 'đ';

        calculateChange();
    }

    function calculateChange() {
        const totalAmount = parseFloat(document.getElementById('totalAmount').textContent.replace(/[^\d]/g, '')) || 0;
        const paidAmount = parseFloat(document.getElementById('paidAmount').value) || 0;
        const change = paidAmount - totalAmount;

        document.getElementById('change').value = change;
    }

    function prepareSubmit() {
        if (cartItems.length === 0) {
            alert('Vui lòng thêm sản phẩm');
            event.preventDefault();
            return;
        }

        // Ghi dữ liệu vào input ẩn (dùng POST binding)
        // Hoặc submit trực tiếp form với POST
    }

    // Allow Enter key to add product
    document.getElementById('quantityInput')?.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            addProduct();
        }
    });
</script>
