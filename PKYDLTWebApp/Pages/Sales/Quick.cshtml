@page
@model PKYDLTWebApp.Pages.Sales.QuickModel
@{
    ViewData["Title"] = "Bán Hàng Nhanh";
}

<div class="container-fluid mt-4">
    @if (Model.PrintSale != null)
    {
        var pr = Model.PrintSale;
        var drugOnly = Model.PrintFormat == "drug";
        var hideItems = Model.PrintFormat == "invoice_noname";
        var cname = pr.Customer?.FullName ?? "Khách lẻ";
        var subItems = pr.SaleDetails?.Sum(x => x.Quantity * x.UnitPrice) ?? 0;
        var disc = pr.DiscountAmount;
        var grand = pr.TotalAmount;
        var paid = pr.PaidAmount;
        var chg = pr.ChangeAmount;
        <style>
            .receipt-card { border: 1px solid #0d6efd; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1); }
            .receipt-table { margin-bottom: 0.5rem; }
            @@media print {
                body * { visibility: hidden; }
                #receiptPrint, #receiptPrint * { visibility: visible; }
                #receiptPrint { position: absolute; left: 0; top: 0; width: 100%; }
            }
        </style>
        <div class="receipt-card card mb-4" id="receiptPrint">
<div class="card-header bg-white text-dark d-flex justify-content-between align-items-center">
                <h4 class="mb-0">@(drugOnly ? "💊 Toa Thuốc" : "🧾 Hóa đơn") — @pr.SaleCode</h4>
                <div>
                    <button type="button" class="btn btn-primary btn-sm" onclick="window.print()">🖨 In</button>
                    <a href="/Sales/Quick" class="btn btn-outline-secondary btn-sm">➕ Bán hàng mới</a>
                </div>
            </div>
            <div class="card-body">
                <div class="row mb-2">
                    <div class="col-md-4"><strong>Khách:</strong> @cname</div>
                    <div class="col-md-4"><strong>Ngày:</strong> @pr.SaleDate.ToString("dd/MM/yyyy HH:mm")</div>
                    <div class="col-md-4"><strong>Phương thức:</strong> @pr.PaymentMethod</div>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm receipt-table">
                        <thead class="table-light">
                            <tr>
                                @if (drugOnly)
                                {
                                    <th>Thuốc</th>
                                    <th>Số lượng</th>
                                    <th>Đầu bán</th>
                                    <th>Ghi chú</th>
                                }
                                else
                                {
                                    @if (!hideItems)
                                    {
                                        <th>Sản phẩm</th>
                                    }
                                    <th>Số lượng</th>
                                    <th>Đơn giá</th>
                                    <th class="text-end">Thành tiền</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in pr.SaleDetails)
                            {
                                var lineTotal = d.Quantity * d.UnitPrice;
                                <tr>
                                    @if (drugOnly)
                                    {
                                        <td>@(d.Product?.ProductName ?? "-")</td>
                                        <td>@d.Quantity @(d.Product?.Unit ?? "")</td>
                                        <td>@(d.Product?.Strength ?? "-")</td>
                                        <td>@(d.Notes ?? "")</td>
                                    }
                                    else
                                    {
                                        @if (!hideItems)
                                        {
                                            <td>
                                                @(d.Product?.ProductName ?? "-")
                                                @if (!string.IsNullOrEmpty(d.Notes))
                                                {
                                                    <br /><small>@d.Notes</small>
                                                }
                                            </td>
                                        }
                                        <td>@d.Quantity</td>
                                        <td>@d.UnitPrice.ToString("#,##0") đ</td>
                                        <td class="text-end">@lineTotal.ToString("#,##0") đ</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (!drugOnly)
                {
                    <div class="row mb-1">
                        <div class="col-6">Tổng hàng:</div><div class="col-6 text-end">@subItems.ToString("#,##0") đ</div>
                        <div class="col-6">Chiết khấu:</div><div class="col-6 text-end">-@disc.ToString("#,##0") đ</div>
                        <div class="col-6 fw-bold">Tổng phải trả:</div><div class="col-6 text-end fw-bold">@grand.ToString("#,##0") đ</div>
                        <div class="col-6">Khách trả:</div><div class="col-6 text-end">@paid.ToString("#,##0") đ</div>
                        <div class="col-6">Thối lại:</div><div class="col-6 text-end">@chg.ToString("#,##0") đ</div>
                    </div>
                }
            </div>
        </div>
        <script>
            window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 500); });
        </script>
    }
    else
    {

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">🛒 Bán Hàng Nhanh</h4>
                </div>
                <div class="card-body">
                    <form method="post" id="saleForm">
                        @if (Model.CopySourceCode != null)
                        {
                            <div class="alert alert-success py-2 mb-2">
                                ⚡ <strong>Sao chép từ đơn bán:</strong> @Model.CopySourceCode —
                                Khách hàng, sản phẩm và số lượng đã điền sẵn. Bạn có thể chỉnh sửa trước khi lưu.
                            </div>
                        }
<div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Mã ghi nhận:</label>
                                <input asp-for="Sale.SaleCode" class="form-control" readonly />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Khách hàng:</label>
                                <div class="position-relative autocomplete-wrap">
                                    <input type="text" id="customerSearch" class="form-control form-control-sm"
                                           placeholder="Type to search customer..." autocomplete="off" />
                                    <input type="hidden" id="customerIdHidden" asp-for="Sale.CustomerId" />
                                    <ul id="customerDropdown" class="autocomplete-menu"></ul>
                                </div>
                                <div class="form-text" id="customerSelectedText">-- Khách lẻ --</div>
                            </div>
                        </div>

                        <!-- Thêm sản phẩm -->
                        <div class="card mb-3">
                            <div class="card-header bg-light">
                                <h6 class="mb-0">Thêm sản phẩm</h6>
                            </div>
                            <div class="card-body">
                                <div class="row g-2">
                                    <div class="col-md-5">
                                        <label class="form-label">Sản phẩm:</label>
                                        <div class="position-relative autocomplete-wrap">
                                            <input type="text" id="productSearch" class="form-control form-control-sm"
                                                   placeholder="Type to search product..." autocomplete="off" />
                                            <ul id="productDropdown" class="autocomplete-menu"></ul>
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">Số lượng:</label>
                                        <input type="number" id="quantityInput" class="form-control" value="1" min="1" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Ghi chú sản phẩm:</label>
                                        <input type="text" id="noteInput" class="form-control" placeholder="ghi chú (nếu có)" />
                                    </div>
                                    <div class="col-md-2 d-flex align-items-end">
                                        <button type="button" class="btn btn-primary w-100" onclick="addProduct()">
                                            ➕ Thêm
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
<!-- Bảng sản phẩm -->
                        <table class="table table-hover" id="productsTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th>Đơn giá</th>
                                    <th>Số lượng</th>
                                    <th>Ghi chú</th>
                                    <th>Thành tiền</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="tableBody"></tbody>
                        </table>

                        <!-- Tính toán -->
                        <div class="row mt-4">
                            <div class="col-md-6 offset-md-6">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="row mb-2">
                                            <div class="col-6">Tổng tiền:</div>
                                            <div class="col-6 text-end"><strong id="subTotal">0đ</strong></div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-6">Discount (%):</div>
                                            <div class="col-6">
                                                <input type="number" id="discountPercent" class="form-control form-control-sm"
                                                       value="0" step="0.1" onchange="calculateTotal()" />
                                            </div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-6">Discount (VND):</div>
                                            <div class="col-6 text-end"><strong id="discountAmount">0đ</strong></div>
                                        </div>
                                        <hr />
                                        <div class="row">
                                            <div class="col-6"><h5>Thành tiền</h5></div>
                                            <div class="col-6 text-end"><h5 id="totalAmount" class="text-primary">0đ</h5></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
<!-- Thanh toan -->
                        <div class="row mt-3">
                            <div class="col-md-12">
                                <div class="card">
                                    <div class="card-header bg-light">
                                        <h6 class="mb-0">Thanh toán</h6>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label asp-for="Sale.PaymentMethod" class="form-label">Phương thức thanh toán</label>
                                                <select asp-for="Sale.PaymentMethod" class="form-select">
                                                    <option value="Tiền mặt">Tiền mặt</option>
                                                    <option value="Chuyển khoản">Chuyển khoản</option>
                                                    <option value="QR Code">QR Code</option>
                                                    <option value="Nợ">Nợ</option>
                                                </select>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label">Khách trả:</label>
                                                <input type="number" id="paidAmount" class="form-control" value="0" onchange="calculateChange()" />
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label">Thối lại:</label>
                                                <input type="number" id="change" class="form-control" readonly />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div id="saleDetailsHidden"></div>
                        <input type="hidden" id="printOptionHidden" name="PrintOption" value="" />

                        <!-- Action buttons -->
                        <div class="mt-4 d-grid gap-2 d-md-flex justify-content-md-end">
                            <a href="/Sales/Index" class="btn btn-secondary">Trờ về</a>
                            <button type="submit" class="btn btn-success btn-lg" onclick="return preparePrintModal()">
                                Lưu và thanh toán
                            </button>
                        </div>
                    </form>
<!-- Print options modal -->
                    <div class="modal fade" id="printModal" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">In</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <p class="text-muted mb-2">Chọn loại in</p>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="salePrintOption" id="poFull" value="invoice" checked>
                                        <label class="form-check-label" for="poFull">Hóa đơn kèm tên SP</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="salePrintOption" id="poNoname" value="invoice_noname">
                                        <label class="form-check-label" for="poNoname">Hóa đơn không kèm tên SP</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="salePrintOption" id="poDrug" value="drug">
                                        <label class="form-check-label" for="poDrug">Toa thuốc</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="salePrintOption" id="poNone" value="none">
                                        <label class="form-check-label" for="poNone">Không in (Chỉ lưu)</label>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Thoát</button>
                                    <button type="button" class="btn btn-success" onclick="confirmPrintSale()">Lưu và in</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Sidebar: guide -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-light">
                    <h6 class="mb-0">Guide</h6>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <ul class="mb-0">
                            <li>Nhập để tìm khách hàng, sản phẩm</li>
                            <li>Chọn số lượng, ghi chú bấm thêm</li>
                            <li>nhập số tiền khách đưa</li>
                            <li>Bấm lưu và chọn in</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
    }
</div>
<!-- Autocomplete data (server-built JSON, parsed client-side) -->
    @if (Model.PrintSale == null)
    {
        <input type="hidden" id="customersData" value="@Model.CustomersJson" />
        <input type="hidden" id="productsData" value="@Model.ProductsJson" />
        @if (Model.CopySourceCode != null)
        {
            <input type="hidden" id="copyDetailsData" value="@Model.CopyDetailsJson" />
        }
    }

<!-- Autocomplete styles -->
<style>
    .autocomplete-wrap { position: relative; }
    .autocomplete-menu {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 1050;
        display: none;
        max-height: 240px;
        overflow-y: auto;
        margin: 2px 0 0 0;
        padding: 0;
        list-style: none;
        background: #fff;
        border: 1px solid #ced4da;
        border-radius: .375rem;
        box-shadow: 0 .5rem 1rem rgba(0, 0, 0, .15);
    }
    .autocomplete-menu.show { display: block; }
    .autocomplete-item { padding: .45rem .75rem; cursor: pointer; font-size: .9rem; }
    .autocomplete-item:hover, .autocomplete-item.active { background: #e9ecef; }
    .autocomplete-empty { padding: .45rem .75rem; color: #6c757d; font-size: .9rem; }
</style>

<!-- JavaScript -->
<script>
    let cartItems = [];

    // Inline data from the server for autocomplete (parsed from hidden fields)
    const customersEl = document.getElementById('customersData');
    const productsEl = document.getElementById('productsData');
    const CUSTOMERS = customersEl ? JSON.parse(customersEl.value) : [];
    const PRODUCTS = productsEl ? JSON.parse(productsEl.value) : [];

    let selectedProduct = null;
    let paidManual = false;

    function debounce(fn, delay) {
        let timer;
        return function (...args) {
            clearTimeout(timer);
            timer = setTimeout(() => fn.apply(this, args), delay);
        };
    }

    function esc(s) {
        return String(s == null ? '' : s)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function closeAllAutocompletes() {
        document.querySelectorAll('.autocomplete-menu').forEach(m => m.classList.remove('show'));
    }

    // Close on click outside the autocomplete wrappers
    document.addEventListener('click', function (e) {
        if (!e.target.closest('.autocomplete-wrap')) closeAllAutocompletes();
    });

    // Close on Escape
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeAllAutocompletes();
    });

    // ============ CUSTOMER AUTOCOMPLETE ============
    const customerInput = document.getElementById('customerSearch');
    const customerDropdown = document.getElementById('customerDropdown');
    const customerIdHidden = document.getElementById('customerIdHidden');

    function renderCustomers(rawKeyword) {
        const kw = (rawKeyword || '').replace(/\s+/g, ' ').trim().toLowerCase();
        let results = kw
            ? CUSTOMERS.filter(c => c.Name.toLowerCase().includes(kw) || c.Phone.toLowerCase().includes(kw))
            : CUSTOMERS;

        if (results.length === 0) {
            customerDropdown.innerHTML = '<li class="autocomplete-empty">No matching customer</li>';
        } else {
            customerDropdown.innerHTML = results.slice(0, 50).map(c =>
                `<li class="autocomplete-item" data-id="${c.Id}" data-name="${esc(c.Name)}" data-phone="${esc(c.Phone)}">` +
                `${esc(c.Name)}${c.Phone ? ' <small>· ' + esc(c.Phone) + '</small>' : ''}</li>`
            ).join('');
        }
        customerDropdown.classList.add('show');
    }

    function onCustomerSelect(li) {
        customerIdHidden.value = li.dataset.id;
        const name = li.dataset.name || '';
        const phone = li.dataset.phone || '';
        customerInput.value = phone ? name + ' (' + phone + ')' : name;
        document.getElementById('customerSelectedText').textContent = phone ? name + ' · ' + phone : name;
        closeAllAutocompletes();
    }

    if (customerInput && customerDropdown) {
        // Debounced (300ms) real-time search on typing
        customerInput.addEventListener('input', debounce(function () {
            renderCustomers(customerInput.value);
        }, 300));

        customerInput.addEventListener('focus', function () {
            renderCustomers(customerInput.value);
        });

        customerDropdown.addEventListener('mousedown', function (e) {
            const li = e.target.closest('.autocomplete-item');
            if (!li) return;
            e.preventDefault();
            onCustomerSelect(li);
        });
    }

    // ============ PRODUCT AUTOCOMPLETE ============
    const productInput = document.getElementById('productSearch');
    const productDropdown = document.getElementById('productDropdown');

    function renderProducts(rawKeyword) {
        const kw = (rawKeyword || '').replace(/\s+/g, ' ').trim().toLowerCase();
        let results = kw
            ? PRODUCTS.filter(p => p.Name.toLowerCase().includes(kw) || p.Code.toLowerCase().includes(kw))
            : PRODUCTS;

        if (results.length === 0) {
            productDropdown.innerHTML = '<li class="autocomplete-empty">No matching product</li>';
        } else {
            productDropdown.innerHTML = results.slice(0, 50).map(p =>
                `<li class="autocomplete-item" data-id="${p.Id}" data-name="${esc(p.Name)}" data-unit="${esc(p.Unit)}" data-price="${p.Price}">` +
                `${esc(p.Code)} - ${esc(p.Name)} <small>· ${esc(p.Unit)}</small></li>`
            ).join('');
        }
        productDropdown.classList.add('show');
    }

    function onProductSelect(li) {
        selectedProduct = {
            id: parseInt(li.dataset.id),
            name: li.dataset.name,
            unit: li.dataset.unit,
            unitPrice: parseFloat(li.dataset.price)
        };
        productInput.value = selectedProduct.name + ' (' + selectedProduct.unit + ')';
        closeAllAutocompletes();
    }

    if (productInput && productDropdown) {
        // Debounced (300ms) real-time search on typing
        productInput.addEventListener('input', debounce(function () {
            selectedProduct = null;
            renderProducts(productInput.value);
        }, 300));

        productInput.addEventListener('focus', function () {
            renderProducts(productInput.value);
        });

        productDropdown.addEventListener('mousedown', function (e) {
            const li = e.target.closest('.autocomplete-item');
            if (!li) return;
            e.preventDefault();
            onProductSelect(li);
        });
    }

    function addProduct() {
        if (!selectedProduct) {
            alert('Please choose a product from the suggestions');
            return;
        }
        const quantity = parseInt(document.getElementById('quantityInput').value) || 1;
        const note = document.getElementById('noteInput').value.trim();

        let item = cartItems.find(x => x.productId === selectedProduct.id);
        if (item) {
            item.quantity += quantity;
            if (note) item.notes = note;
        } else {
            cartItems.push({
                productId: selectedProduct.id,
                productName: selectedProduct.name,
                unitPrice: selectedProduct.unitPrice,
                unit: selectedProduct.unit,
                quantity,
                notes: note
            });
        }

        renderTable();
        paidManual = false;
        calculateTotal();

        selectedProduct = null;
        productInput.value = '';
        document.getElementById('quantityInput').value = '1';
        document.getElementById('noteInput').value = '';
    }

    function removeProduct(productId) {
        cartItems = cartItems.filter(x => x.productId !== productId);
        renderTable();
        paidManual = false;
        calculateTotal();
    }
function renderTable() {
        const tbody = document.getElementById('tableBody');
        tbody.innerHTML = '';
        cartItems.forEach(item => {
            const total = item.unitPrice * item.quantity;
            tbody.innerHTML += `
                <tr>
                    <td>${item.productName}<br/><small class="text-muted">${item.unit}</small></td>
                    <td>${item.unitPrice.toLocaleString('vi-VN')} <small>VND</small></td>
                    <td><input type="number" value="${item.quantity}" min="1" onchange="updateQuantity(${item.productId}, this.value)" style="width:60px;" class="form-control form-control-sm"/></td>
                    <td><input type="text" value="${item.notes || ''}" onchange="updateNote(${item.productId}, this.value)" class="form-control form-control-sm" style="min-width:110px;"/></td>
                    <td>${total.toLocaleString('vi-VN')} <small>VND</small></td>
                    <td><button type="button" class="btn btn-sm btn-danger" onclick="removeProduct(${item.productId})">x</button></td>
                </tr>`;
        });
    }

    function updateQuantity(productId, newQuantity) {
        const item = cartItems.find(x => x.productId === productId);
        if (item) {
            item.quantity = parseInt(newQuantity) || 1;
            paidManual = false;
            renderTable();
            calculateTotal();
        }
    }

    function updateNote(productId, note) {
        const item = cartItems.find(x => x.productId === productId);
        if (item) item.notes = note.trim();
    }

    function calculateTotal() {
        const subTotal = cartItems.reduce((sum, item) => sum + (item.unitPrice * item.quantity), 0);
        const discountPercent = parseFloat(document.getElementById('discountPercent').value) || 0;
        const discountAmount = subTotal * (discountPercent / 100);
        const totalAmount = subTotal - discountAmount;
        document.getElementById('subTotal').textContent = subTotal.toLocaleString('vi-VN') + ' VND';
        document.getElementById('discountAmount').textContent = discountAmount.toLocaleString('vi-VN') + ' VND';
        document.getElementById('totalAmount').textContent = totalAmount.toLocaleString('vi-VN') + ' VND';

        // Auto-fill "Khách trả" with the total (customer pays in full) unless manually overridden
        const paidEl = document.getElementById('paidAmount');
        if (paidEl && !paidManual) {
            paidEl.value = totalAmount;
        }
        calculateChange();
    }

    function calculateChange() {
        const totalAmount = parseFloat(document.getElementById('totalAmount').textContent.replace(/[^\d-]/g, '')) || 0;
        const paidAmount = parseFloat(document.getElementById('paidAmount').value) || 0;
        document.getElementById('change').value = (paidAmount - totalAmount);
    }
function prepareHiddenDetails() {
        const container = document.getElementById('saleDetailsHidden');
        container.innerHTML = '';
        cartItems.forEach((item, i) => {
            container.innerHTML += `
                <input type="hidden" name="SaleDetails[${i}].ProductId" value="${item.productId}" />
                <input type="hidden" name="SaleDetails[${i}].Quantity" value="${item.quantity}" />
                <input type="hidden" name="SaleDetails[${i}].UnitPrice" value="${item.unitPrice}" />
                <input type="hidden" name="SaleDetails[${i}].Notes" value="${item.notes || ''}" />`;
        });
        const discountInput = document.createElement('input');
        discountInput.type = 'hidden';
        discountInput.name = 'Sale.DiscountPercent';
        discountInput.value = document.getElementById('discountPercent').value || '0';
        container.appendChild(discountInput);

        const paidInput = document.createElement('input');
        paidInput.type = 'hidden';
        paidInput.name = 'Sale.PaidAmount';
        paidInput.value = document.getElementById('paidAmount').value || '0';
        container.appendChild(paidInput);
    }

    function preparePrintModal() {
        if (cartItems.length === 0) {
            alert('Please add at least one product');
            return false;
        }
        prepareHiddenDetails();
        const m = new bootstrap.Modal(document.getElementById('printModal'));
        m.show();
        return false;
    }

    function confirmPrintSale() {
        const selected = document.querySelector('input[name="salePrintOption"]:checked');
        document.getElementById('printOptionHidden').value = selected ? selected.value : 'none';
        document.getElementById('saleForm').submit();
    }

    // ============ SAO CHÉP BÁN HÀNG (pre-fill cart & customer) ============
    function applyCopyData() {
        const copyEl = document.getElementById('copyDetailsData');
        if (!copyEl) return;
        let items = [];
        try { items = JSON.parse(copyEl.value) || []; } catch (e) { items = []; }
        if (!items.length) return;

        items.forEach(item => {
            cartItems.push({
                productId: item.productId,
                productName: item.productName,
                unitPrice: item.unitPrice,
                unit: item.unit || '',
                quantity: parseInt(item.quantity) || 1,
                notes: item.notes || ''
            });
        });

        // Điền sẵn khách hàng đã có trên server (Sale.CustomerId)
        const custId = customerIdHidden ? customerIdHidden.value : '';
        const cust = custId ? CUSTOMERS.find(c => String(c.Id) === String(custId)) : null;
        if (cust && customerInput) {
            customerInput.value = cust.Phone ? cust.Name + ' (' + cust.Phone + ')' : cust.Name;
            const selText = document.getElementById('customerSelectedText');
            if (selText) selText.textContent = cust.Phone ? cust.Name + ' · ' + cust.Phone : cust.Name;
        }

        paidManual = false;
        renderTable();
        calculateTotal();
    }
    applyCopyData();

    document.getElementById('quantityInput')?.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            addProduct();
        }
    });

    // Typing in "Khách trả" marks it as a manual override (auto-fill stops)
    document.getElementById('paidAmount')?.addEventListener('input', function() {
        paidManual = true;
    });
</script>